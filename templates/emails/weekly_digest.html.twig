{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_components.html.twig' as ui %}

{# Message-weighted across the whole team, not the mean of the per-domain
   percentages — see WeeklyDigestData::overallPassRate(). A null rate means "no
   DMARC records in this window" and never 0%. Emails are inline-styled, so the
   no-data tint is the same muted slate the rest of the template uses for
   absent values. #}
{% set overallPassRate = digest.overallPassRate() %}
{% set passRateColor = overallPassRate is null
    ? '#94a3b8'
    : (overallPassRate >= 95
        ? '#16a34a'
        : (overallPassRate >= 80 ? '#d97706' : '#dc2626')) %}

{% block subject %}Sendvery weekly report — {{ digest.teamName }}{% endblock %}
{% block preheader %}{{ digest.totalMessages|number_format }} messages · {{ overallPassRate is null ? 'no reports yet' : overallPassRate|number_format(1) ~ '% pass rate' }} · {{ digest.totalDomains }} domain{{ digest.totalDomains != 1 ? 's' : '' }}.{% endblock %}
{% block header_meta %}{{ dateRange }}{% endblock %}

{% block content %}
    {# The date range already shows in the header meta slot — repeating it here
       cost a line of vertical space and said nothing new. #}
    {{ ui.pretitle('Weekly report') }}
    {{ ui.heading('How ' ~ digest.teamName|e ~ ' did this week') }}

    {# EVERY SECTION BELOW IS DECLARED TWICE ON PURPOSE.

       Once as a section-name comment, and once as a sections.has(...) guard.

       The comment is what the section guard test counts: it is how a section
       added straight to this markup, with no counterpart in the plain-text
       alternative, gets caught before a customer reads a half-empty email. The
       guard is the shared answer to "is this section in this week's digest?",
       so the two renderers cannot disagree about it.

       Adding a section therefore means three edits — a WeeklyDigestSection
       case, a marked block here, and a block in WeeklyDigestPlainTextRenderer.
       Leaving any of the three out fails a test. #}

    {# section: summary #}
    {# Summary stat tiles — always shown; a digest with no numbers is not a digest. #}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 8px 0 24px 0;">
        <tr>
            <td width="33%" style="padding: 4px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                    <tr><td style="padding: 16px 12px; text-align: center;">
                        <div style="font-size: 26px; font-weight: 700; color: #0f172a; line-height: 1.1; letter-spacing: -0.02em;">{{ digest.totalMessages|number_format }}</div>
                        <div style="margin-top: 6px; font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em;">Messages</div>
                    </td></tr>
                </table>
            </td>
            <td width="33%" style="padding: 4px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                    <tr><td style="padding: 16px 12px; text-align: center;">
                        <div style="font-size: {{ overallPassRate is null ? '18px' : '26px' }}; font-weight: 700; color: {{ passRateColor }}; line-height: 1.1; letter-spacing: -0.02em;">{{ overallPassRate is null ? '—' : overallPassRate|number_format(1) ~ '%' }}</div>
                        <div style="margin-top: 6px; font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em;">Pass rate</div>
                    </td></tr>
                </table>
            </td>
            <td width="33%" style="padding: 4px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                    <tr><td style="padding: 16px 12px; text-align: center;">
                        <div style="font-size: 26px; font-weight: 700; color: #0f172a; line-height: 1.1; letter-spacing: -0.02em;">{{ digest.totalDomains }}</div>
                        <div style="margin-top: 6px; font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em;">Domain{{ digest.totalDomains != 1 ? 's' : '' }}</div>
                    </td></tr>
                </table>
            </td>
        </tr>
    </table>

    {# section: ai_summary #}
    {# AI plans only; additive, non-AI teams get the digest unchanged. #}
    {% if sections.has('ai_summary') %}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 24px 0;">
            <tr><td style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px 18px;">
                <div style="font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">AI summary</div>
                <div style="font-size: 14px; color: #0f172a; line-height: 1.6; white-space: pre-line;">{{ aiSummary.summaryMarkdown }}</div>
                {% if aiSummary.recommendations|length > 0 %}
                    <ul style="margin: 12px 0 0 0; padding-left: 18px; font-size: 14px; color: #0f172a; line-height: 1.6;">
                        {% for recommendation in aiSummary.recommendations %}
                            <li>{{ recommendation }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </td></tr>
        </table>
    {% endif %}

    {# section: domain_breakdown #}
    {% if sections.has('domain_breakdown') %}
        {{ ui.subheading('Domain breakdown') }}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 8px 0; border-collapse: collapse;">
            <tr>
                <td style="padding: 8px 12px; font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em; background-color: #f8fafc; border-radius: 8px 0 0 8px;">Domain</td>
                <td style="padding: 8px 12px; font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em; background-color: #f8fafc; text-align: right;">Messages</td>
                <td style="padding: 8px 12px; font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em; background-color: #f8fafc; text-align: right;">Pass rate</td>
                <td style="padding: 8px 12px; font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em; background-color: #f8fafc; text-align: right; border-radius: 0 8px 8px 0;">Δ</td>
            </tr>
            {% for domain in digest.domains %}
                {# Same no-data rule as the dashboard cards: a domain that
                   received nothing this week reads "waiting for first report",
                   not a red 0% that accuses it of failing every message. #}
                {% set domainColor = not domain.hasPassRateData()
                    ? '#64748b'
                    : (domain.passRate >= 95
                        ? '#16a34a'
                        : (domain.passRate >= 80 ? '#d97706' : '#dc2626')) %}
                <tr>
                    <td style="padding: 12px; font-size: 13px; color: #0f172a; font-weight: 500; border-bottom: 1px solid #f1f5f9; font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;">{{ domain.domainName }}</td>
                    <td style="padding: 12px; font-size: 13px; color: #475569; text-align: right; border-bottom: 1px solid #f1f5f9;">{{ domain.totalMessages|number_format }}</td>
                    <td style="padding: 12px; font-size: {{ domain.hasPassRateData() ? '13px' : '12px' }}; color: {{ domainColor }}; font-weight: {{ domain.hasPassRateData() ? '600' : '500' }}; text-align: right; border-bottom: 1px solid #f1f5f9;">
                        {{- domain.hasPassRateData() ? domain.passRate|number_format(1) ~ '%' : 'Waiting for first report' -}}
                    </td>
                    <td style="padding: 12px; font-size: 13px; text-align: right; border-bottom: 1px solid #f1f5f9;">
                        {% if domain.passRateDelta is not null %}
                            <span style="color: {{ domain.passRateDelta >= 0 ? '#16a34a' : '#dc2626' }}; font-weight: 500;">
                                {{ domain.passRateDelta >= 0 ? '+' : '' }}{{ domain.passRateDelta|number_format(1) }}%
                            </span>
                        {% else %}
                            <span style="color: #cbd5e1;">—</span>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}

    {# section: attention_alerts #}
    {# The few most severe UNRESOLVED problems, grouped per domain + type so a
       chatty week doesn't turn into a dozen near-identical amber rows.
       Already-resolved and Success-severity alerts are excluded by the
       generator: listing a fixed problem as outstanding is how a digest teaches
       people to ignore it. #}
    {% if sections.has('attention_alerts') %}
        {# Counts GROUPS, not raw alerts — the "×N this week" badge on each row
           carries the volume, and "(20)" above a list of 5 rows just looked
           like the email had swallowed something. #}
        {{ ui.subheading('Needs your attention <span style="font-weight:400;color:#94a3b8;font-size:13px;">(' ~ digest.attentionAlertGroups ~ ')</span>') }}
        {% set alertPalette = {
            critical: { bg: '#fef2f2', border: '#dc2626', label: '#991b1b' },
            warning:  { bg: '#fffbeb', border: '#d97706', label: '#92400e' },
            info:     { bg: '#eff6ff', border: '#2563eb', label: '#1e3a8a' }
        } %}
        {% for alert in digest.attentionAlerts %}
            {% set ap = alertPalette[alert.severity.value] ?? alertPalette.info %}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 6px 0;">
                <tr><td style="padding: 10px 14px; background-color: {{ ap.bg }}; border-left: 3px solid {{ ap.border }}; border-radius: 0 8px 8px 0;">
                    <div style="font-size: 11px; font-weight: 600; color: {{ ap.label }}; text-transform: uppercase; letter-spacing: 0.06em;">
                        {{- alert.domainName ?? 'Account' -}}
                        {%- if alert.occurrences > 1 %} · {{ alert.occurrences }}× this week{% endif -%}
                    </div>
                    <div style="margin-top: 2px; font-size: 13px; color: #0f172a;">{{ alert.title }}</div>
                </td></tr>
            </table>
        {% endfor %}
        {% if digest.hasMoreAttentionAlerts() %}
            <p style="margin: 8px 0 0 0; font-size: 13px; color: #64748b;">
                Showing {{ digest.attentionAlerts|length }} of {{ digest.attentionAlertGroups }} —
                <a href="{{ alertsUrl }}" style="color: #0f766e; text-decoration: none; font-weight: 500;">see all alerts</a>
            </p>
        {% endif %}
    {% endif %}

    {# section: resolved_alerts #}
    {# Good news: problems that got fixed. Balances the section above so the
       digest is a status report, not a list of complaints. #}
    {% if sections.has('resolved_alerts') %}
        {{ ui.callout(
            'success',
            '<strong>' ~ digest.resolvedAlertsCount ~ '</strong> issue' ~ (digest.resolvedAlertsCount != 1 ? 's' : '') ~ ' resolved this week.'
        ) }}
    {% endif %}

    {# Senders waiting for a decision — driven by real authorization state
       (`known_sender`), not by "appeared this week". A sender discovered a
       month ago and never reviewed keeps showing up here until somebody
       decides, which is exactly what the "New senders discovered" section
       below cannot do.

       Links are generated with url() rather than passed in: this template is
       rendered from a worker with no request, so url() resolves against
       framework.router.default_uri — the same source the handler's
       $dashboardUrl comes from, and the same source
       WeeklyDigestPlainTextRenderer generates the identical link from. #}
    {# section: sender_review #}
    {% if sections.has('sender_review') %}
        {{ ui.subheading('Waiting for your review <span style="font-weight:400;color:#94a3b8;font-size:13px;">(' ~ digest.sendersAwaitingReviewCount() ~ ')</span>') }}

        <p style="margin: 0 0 14px 0; font-size: 14px; line-height: 1.6; color: #475569;">
            These servers have sent mail as your domains and nobody has said yet whether they are yours. Nothing is
            blocked either way — marking them just stops us flagging mail you already trust.
        </p>

        {% for domain in digest.domains %}
            {% if domain.senderReview.hasAny() %}
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 8px 0;">
                    <tr><td style="padding: 12px 16px; background-color: #fffbeb; border: 1px solid #fde68a; border-radius: 10px;">
                        <div style="font-size: 13px; font-weight: 600; color: #92400e;">
                            <span style="font-family:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;">{{ domain.domainName }}</span>
                            &middot; {{ domain.senderReview.needsReviewCount }} sender{{ domain.senderReview.needsReviewCount != 1 ? 's' : '' }}
                            {%- if domain.senderReview.needsReviewMessages > 0 %}, {{ domain.senderReview.needsReviewMessages|number_format }} message{{ domain.senderReview.needsReviewMessages != 1 ? 's' : '' }}{% endif -%}
                        </div>
                        <div style="margin-top: 6px; font-size: 12px; color: #78350f; line-height: 1.8;">
                            {% for sender in domain.senderReview.topSenderNames %}
                                <span style="display: inline-block; padding: 2px 9px; margin: 2px 4px 2px 0; background-color: #ffffff; color: #92400e; border: 1px solid #fde68a; border-radius: 999px; font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;">{{ sender }}</span>
                            {% endfor %}
                            {% if domain.senderReview.hasMoreThanNamed() %}
                                <span style="display: inline-block; padding: 2px 9px; margin: 2px 4px 2px 0; color: #a16207;">+{{ domain.senderReview.unnamedCount() }} more</span>
                            {% endif %}
                        </div>
                        <div style="margin-top: 8px; font-size: 13px;">
                            <a href="{{ url('dashboard_sender_inventory', { domainId: domain.domainId, filter: 'needs_review' }) }}"
                               style="color: #0f766e; text-decoration: none; font-weight: 500;">Review these senders &rarr;</a>
                        </div>
                    </td></tr>
                </table>
            {% endif %}
        {% endfor %}

        <p style="margin: 8px 0 16px 0; font-size: 12px; line-height: 1.6; color: #94a3b8;">
            Not sure how to tell? Strong signs a sender is yours: you recognise the organisation, DKIM and SPF pass
            close to 100%, and the volume matches mail you actually send.
        </p>
    {% endif %}

    {# New senders — one block per domain with a total, then at most
       `senderRowLimit` rows and a "+N more" tail. A domain that discovers
       thirty senders in a week must not push the rest of the digest off screen.

       Each row names what the sender IS, not just where it came from. Senders
       are grouped by identity (a provider's whole IP pool is one row) and the
       role decides the tint: an own relay, a provider and a forwarder are
       normal mail flow and read as calm, while only an unrecognised or
       suspicious sender is coloured to pull the eye. The digest that triggered
       DEC-059 printed a wall of raw IPv6 addresses in identical green chips,
       so a recipient-side mail gateway looked exactly like an attacker. #}
    {% set senderRowLimit = constant('App\\Services\\Digest\\WeeklyDigestGenerator::NEW_SENDERS_PER_DOMAIN_LIMIT') %}
    {% set rolePalette = {
        own_relay:  { bg: '#f0fdf4', border: '#bbf7d0', label: '#166534', meta: '#15803d' },
        esp:        { bg: '#f0fdf4', border: '#bbf7d0', label: '#166534', meta: '#15803d' },
        forwarder:  { bg: '#f8fafc', border: '#e2e8f0', label: '#334155', meta: '#64748b' },
        unknown:    { bg: '#fffbeb', border: '#fde68a', label: '#92400e', meta: '#a16207' },
        suspicious: { bg: '#fef2f2', border: '#fecaca', label: '#991b1b', meta: '#b91c1c' }
    } %}
    {# section: new_senders #}
    {% if sections.has('new_senders') %}
        {{ ui.subheading('New senders discovered <span style="font-weight:400;color:#94a3b8;font-size:13px;">(' ~ digest.newSendersCount() ~ ')</span>') }}

        <p style="margin: 0 0 14px 0; font-size: 14px; line-height: 1.6; color: #475569;">
            Servers that sent mail as your domains for the first time. We have labelled each one — mail gateways and
            forwarding services break SPF by design, so a few failures from those are normal rather than a problem.
        </p>

        {% for domain in digest.domains %}
            {% if domain.newSenders|length > 0 %}
                <p style="margin: 0 0 6px 0; font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.06em;">
                    {{ domain.domainName }} · {{ domain.newSenders|length }} new
                </p>
                {% for sender in domain.newSenders|slice(0, senderRowLimit) %}
                    {% set rp = rolePalette[sender.role.value] ?? rolePalette.unknown %}
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 6px 0;">
                        <tr><td style="padding: 10px 14px; background-color: {{ rp.bg }}; border: 1px solid {{ rp.border }}; border-radius: 10px;">
                            <div style="font-size: 13px; font-weight: 600; color: {{ rp.label }}; font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;">{{ sender.label }}</div>
                            <div style="margin-top: 3px; font-size: 12px; color: {{ rp.meta }};">
                                {{- sender.role.label() }} ·
                                {{ sender.messageCount|number_format }} message{{ sender.messageCount != 1 ? 's' : '' }}
                                {%- if sender.passRate() is not null %} · {{ sender.passRate()|number_format(1) }}% pass{% endif -%}
                            </div>
                        </td></tr>
                    </table>
                {% endfor %}
                {% if domain.newSenders|length > senderRowLimit %}
                    <p style="margin: 0 0 14px 0; font-size: 12px; color: #64748b;">+{{ domain.newSenders|length - senderRowLimit }} more</p>
                {% else %}
                    <div style="height: 8px; line-height: 8px;">&nbsp;</div>
                {% endif %}
            {% endif %}
        {% endfor %}
    {% endif %}

    {# section: broken_dns #}
    {% if sections.has('broken_dns') %}
        {{ ui.subheading('DNS records still broken') }}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 16px 0;">
            <tr><td style="padding: 14px 18px; background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 10px;">
                {% for item in digest.currentlyBrokenDns %}
                    <div style="margin-bottom: {{ loop.last ? '0' : '14px' }};">
                        <div style="font-size: 13px; color: #991b1b; font-weight: 600; margin-bottom: 4px;">
                            {{ item.checkType }} — <span style="font-family:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;">{{ item.domainName }}</span>
                        </div>
                        {% for message in item.issueMessages %}
                            <div style="font-size: 12px; color: #7f1d1d; line-height: 1.6;">{{ message }}</div>
                        {% endfor %}
                        <div style="margin-top: 4px; font-size: 11px; color: #b91c1c;">Last checked {{ item.checkedAt|date('M j, H:i') }}</div>
                    </div>
                {% endfor %}
            </td></tr>
        </table>
    {% endif %}

    {# section: dns_changes #}
    {% if sections.has('dns_changes') %}
        {{ ui.callout(
            'warning',
            '<strong>' ~ digest.dnsChangesCount ~ '</strong> DNS change' ~ (digest.dnsChangesCount != 1 ? 's' : '') ~ ' detected this week.'
        ) }}
    {% endif %}

    {{ ui.button('View full dashboard', dashboardUrl) }}
{% endblock %}

{% block footer_note %}
    <p style="margin: 0 0 6px 0; font-size: 11px; color: #94a3b8;">
        You can manage your email preferences in your dashboard settings.
    </p>
{% endblock %}
