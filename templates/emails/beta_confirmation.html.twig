{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_components.html.twig' as ui %}

{# Sent to everyone who submits the notify form under a public DNS checker.
   This has not been a beta waitlist mail since launch.

   Deliberately does NOT claim we will alert them when their records change:
   nothing reads `beta_signup` yet, so that would repeat a promise the system
   does not keep. The form above it already over-promises; see the note in
   SubmitToolNotifyController. Wording here stays to what confirming actually
   does. #}
{% block subject %}Confirm your email address{% endblock %}
{% block preheader %}One click to confirm the address you just gave us.{% endblock %}

{% block content %}
    {{ ui.pretitle('Confirm your email') }}
    {{ ui.heading('One click and you’re set') }}

    {{ ui.lead('You asked us to keep you posted about your domain’s email setup. Confirm your address below so we know it’s really you.') }}

    {{ ui.button('Confirm my email', confirmUrl) }}

    {{ ui.subheading('What happens next?') }}
    {{ ui.muted('That’s it — you’re on the list, and no account is needed. If you’d rather monitor your domain properly, you can create a free account any time.') }}

    {{ ui.link_fallback(confirmUrl) }}
{% endblock %}
