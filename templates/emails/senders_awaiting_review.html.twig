{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_components.html.twig' as ui %}

{% block subject %}{{ senderCount }} sender{{ senderCount != 1 ? 's' : '' }} waiting for your review{% endblock %}
{% block preheader %}Servers are sending mail as your domains and nobody has said yet whether they're yours.{% endblock %}

{% block content %}
    {{ ui.pretitle('Needs your decision', '#d97706') }}
    {{ ui.heading(senderCount ~ ' sender' ~ (senderCount != 1 ? 's' : '') ~ ' waiting for your review') }}

    {{ ui.lead(
        'Sendvery has seen ' ~ (senderCount != 1 ? 'these servers' : 'this server') ~ ' sending mail as your '
        ~ (domains|length != 1 ? 'domains' : 'domain') ~ ', and nobody has said yet whether '
        ~ (senderCount != 1 ? 'they are' : 'it is') ~ ' yours.'
    ) }}

    {{ ui.paragraph('Marking them changes no DNS and blocks no mail — it just tells us which senders you already trust, so the ones you don’t stand out.') }}

    {% for domain in domains %}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 10px 0;">
            <tr><td style="padding: 14px 18px; background-color: #fffbeb; border: 1px solid #fde68a; border-radius: 10px;">
                <div style="font-size: 14px; font-weight: 600; color: #92400e;">
                    <span style="font-family:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;">{{ domain.domainName }}</span>
                </div>
                <div style="margin-top: 4px; font-size: 13px; color: #78350f;">
                    {{ domain.needsReviewCount }} sender{{ domain.needsReviewCount != 1 ? 's' : '' }} &middot;
                    {{ domain.needsReviewMessages|number_format }} message{{ domain.needsReviewMessages != 1 ? 's' : '' }}
                    {%- if domain.sharePercent() >= 1 %} &middot; {{ domain.sharePercent()|number_format(0) }}% of this domain’s mail{% endif %}
                </div>
                <div style="margin-top: 8px; font-size: 12px; color: #78350f; line-height: 1.9;">
                    {% for sender in domain.topSenderNames %}
                        <span style="display: inline-block; padding: 2px 9px; margin: 2px 4px 2px 0; background-color: #ffffff; color: #92400e; border: 1px solid #fde68a; border-radius: 999px; font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;">{{ sender }}</span>
                    {% endfor %}
                    {% if domain.hasMoreThanNamed() %}
                        <span style="display: inline-block; padding: 2px 9px; margin: 2px 4px 2px 0; color: #a16207;">+{{ domain.unnamedCount() }} more</span>
                    {% endif %}
                </div>
                <div style="margin-top: 10px; font-size: 13px;">
                    <a href="{{ url('dashboard_sender_inventory', { domainId: domain.domainId, filter: 'needs_review' }) }}"
                       style="color: #0f766e; text-decoration: none; font-weight: 500;">Review {{ domain.domainName }}’s senders &rarr;</a>
                </div>
            </td></tr>
        </table>
    {% endfor %}

    {{ ui.subheading('How do I tell if a sender is really mine?') }}
    <p style="margin: 0 0 16px 0; font-size: 14px; line-height: 1.7; color: #334155;">
        Three signals together are strong evidence:
    </p>
    <ol style="margin: 0 0 16px 0; padding-left: 20px; font-size: 14px; line-height: 1.7; color: #334155;">
        <li><strong>You recognise the organisation</strong> — your mail provider, newsletter tool, CRM, something you pay for.</li>
        <li><strong>DKIM passes close to 100%</strong> — a spoofer cannot sign with your DKIM key, so consistent DKIM pass means whoever runs that server holds it.</li>
        <li><strong>The volume matches mail you actually send.</strong></li>
    </ol>

    {{ ui.button('Review your senders', dashboardUrl, '#d97706') }}

    {{ ui.callout('neutral', 'If you do nothing, no mail is blocked or released — sender statuses never touch your DNS or your DMARC policy. Unreviewed senders simply keep being flagged in your dashboard and your weekly report. We will not email you about this again for at least 30 days.') }}
{% endblock %}

{% block footer_note %}
    <p style="margin: 0 0 6px 0; font-size: 11px; color: #94a3b8;">
        You’re receiving this because email alerts are on for your account. You can turn them off in your dashboard settings.
    </p>
{% endblock %}
