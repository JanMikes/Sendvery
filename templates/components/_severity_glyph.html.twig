{#
   Shared severity glyph — single source of truth for the leading row-glyph
   used across TASK-066 (DomainCard) family of list surfaces:
   TASK-068 mailboxes, TASK-069 reports, TASK-070 alerts, TASK-071 quarantine.

   `severity` accepts one of: 'success'|'warning'|'error'|'info'|'neutral'.
   `neutral` renders as the daisyUI base-300 ghost dot used for "inactive"
   / undifferentiated rows where success/warning/error would all over-claim.

   `size` accepts 'sm' (24px → w-6 h-6), 'md' (32px → w-8 h-8),
   'lg' (40px → w-10 h-10). The icon glyph inside scales to about half.

   SVG paths are lifted from the canonical glyphs already shipping in the
   codebase (overview.html.twig:20 check-circle, alerts.html.twig:101
   exclamation-triangle, the universal exclamation-circle / info-circle).
#}
{% macro glyph(severity, size = 'sm') %}
    {%- set wrapperClass = {
        'sm': 'w-6 h-6',
        'md': 'w-8 h-8',
        'lg': 'w-10 h-10',
    }[size] ?? 'w-6 h-6' -%}
    {%- set iconClass = {
        'sm': 'w-3.5 h-3.5',
        'md': 'w-4 h-4',
        'lg': 'w-5 h-5',
    }[size] ?? 'w-3.5 h-3.5' -%}
    {%- set tone = severity == 'neutral' ? 'base-content/40' : severity -%}
    {%- set bgTone = severity == 'neutral' ? 'base-300' : severity -%}
    <span class="{{ wrapperClass }} rounded-full bg-{{ bgTone }}/10 flex items-center justify-center shrink-0" aria-hidden="true">
        <svg class="{{ iconClass }} text-{{ tone }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            {%- if severity == 'success' -%}
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            {%- elseif severity == 'warning' -%}
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
            {%- elseif severity == 'error' -%}
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            {%- elseif severity == 'info' -%}
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            {%- else -%}
                {# neutral: 8px-ish hollow dot — visually quiet for inactive rows. #}
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 12m-3 0a3 3 0 106 0a3 3 0 10-6 0"/>
            {%- endif -%}
        </svg>
    </span>
{% endmacro %}

{#
   ── NO-DATA PASS-RATE CONVENTION ─────────────────────────────────────────────

   A null `passRate` means "we have no DMARC records to grade" — NOT "0% of
   messages passed". Rendering the two the same way told users their
   brand-new, correctly-configured domain was failing every single message.

   Every surface that shows a pass rate uses these macros so the honest state
   is written once:

       {% import 'components/_severity_glyph.html.twig' as severity %}

       {# right-aligned hero number on a card #}
       {{ severity.pass_rate_stat(domain.passRate, domain.isAwaitingFirstReport(), 'lg') }}

       {# compact number in a list row #}
       {{ severity.pass_rate_stat(domain.passRate, domain.isAwaitingFirstReport(), 'sm') }}

       {# just the tint, e.g. to colour a sparkline that sits next to it #}
       <span class="{{ severity.pass_rate_class(domain.passRate)|trim }}">…</span>

   `isAwaitingFirstReport()` (never received a report) vs. "received, but
   nothing in this window" only changes the wording — both suppress the number.
#}

{#
   passRate → severity tone. Mirrors the thresholds used inline across
   templates (≥90 success, 70–89.99 warning, <70 error). Null pass-rate is
   `neutral`, deliberately: an absence of data is not a warning, and painting
   it amber is what made "waiting for the first report" read as a failure.
   Domains that genuinely need attention are flagged by the health classifier,
   which has DNS state to judge — not by a missing number.
#}
{% macro pass_rate_tone(passRate) %}
    {%- if passRate is null -%}neutral
    {%- elseif passRate >= 90 -%}success
    {%- elseif passRate >= 70 -%}warning
    {%- else -%}error
    {%- endif -%}
{% endmacro %}

{#
   Ready-to-use text colour class for a pass rate. Wraps `pass_rate_tone` and
   maps the `neutral` tone onto the muted base-content tint the glyph macro
   already uses for undifferentiated rows.
#}
{% macro pass_rate_class(passRate) %}
    {%- if passRate is null -%}text-base-content/40
    {%- elseif passRate >= 90 -%}text-success
    {%- elseif passRate >= 70 -%}text-warning
    {%- else -%}text-error
    {%- endif -%}
{% endmacro %}

{#
   Row accent tone for a pass rate — feeds `border-l-{{ … }}` on list rows.
   Mirrors `pass_rate_tone` but maps the `neutral` tone onto `base-300`, the
   quiet accent the mailboxes and quarantine tables already use for
   undifferentiated rows. daisyUI's `neutral` is a dark slate, so using it here
   would make a row we have not measured shout louder than a healthy one.
#}
{% macro pass_rate_row_tone(passRate) %}
    {%- import _self as severity -%}
    {%- set tone = severity.pass_rate_tone(passRate)|trim -%}
    {{- tone == 'neutral' ? 'base-300' : tone -}}
{% endmacro %}

{#
   The pass-rate figure itself, or an em-dash when there is nothing to show.
   Matches the placeholder `DomainPassRateSparkline` renders for an empty
   series, so the number and the trend line never contradict each other.
#}
{% macro pass_rate_value(passRate) %}
    {%- if passRate is null -%}—
    {%- else -%}{{ passRate|number_format(1) }}%
    {%- endif -%}
{% endmacro %}

{#
   Complete pass-rate stat block — the number plus its caption, or the honest
   "waiting" state when `passRate` is null.

   `awaitingFirstReport` = true  → the domain has never received a report.
   `awaitingFirstReport` = false → it has, but not inside the current window
                                   (e.g. reports aged out of retention).

   `size`: 'lg' for the hero number on a card (two lines, number + caption),
           'sm' for a single inline figure in a dense list row.
#}
{% macro pass_rate_stat(passRate, awaitingFirstReport = true, size = 'lg') %}
    {%- import _self as severity -%}
    {%- if passRate is null -%}
        {%- set waitingLabel = awaitingFirstReport ? 'Waiting for first report' : 'No reports in this period' -%}
        {%- if size == 'sm' -%}
            <span class="text-xs font-medium text-base-content/50 whitespace-nowrap">{{ waitingLabel }}</span>
        {%- else -%}
            <div class="text-sm font-semibold text-base-content/60">{{ waitingLabel }}</div>
            <span class="text-xs text-base-content/50">
                {{- awaitingFirstReport ? 'usually within 24 hours' : 'nothing to grade yet' -}}
            </span>
        {%- endif -%}
    {%- else -%}
        {%- set toneClass = severity.pass_rate_class(passRate)|trim -%}
        {%- if size == 'sm' -%}
            <span class="text-sm font-semibold {{ toneClass }}">{{ passRate|number_format(1) }}%</span>
        {%- else -%}
            <div class="text-2xl font-bold {{ toneClass }}">{{ passRate|number_format(1) }}%</div>
            <span class="text-xs text-base-content/50">pass rate</span>
        {%- endif -%}
    {%- endif -%}
{% endmacro %}
