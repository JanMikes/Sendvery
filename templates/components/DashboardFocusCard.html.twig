{#
   The single hero of /app. Two zones inside ONE card:

     1. STATUS  — "how are we?" (healthSummary headline) plus every drill-down
        count as chips.
     2. NEXT STEP — "what do I do?" (the one action NextActionResolver picked).

   It replaces three separately-stacked surfaces that all answered a version of
   the same question: the health-summary banner, the "N things need your
   attention today" line, and the standalone next-action card. The counts in the
   chip row come from AttentionSummaryResolver, which classifies the same domain
   set HealthSummaryResolver counts — so the headline and the chips cannot
   disagree the way they used to.
#}
{% props healthSummary, attentionSummary, nextAction %}

{% set tone = {
    success: {bar: 'bg-success', badge: 'bg-success/10 text-success'},
    warning: {bar: 'bg-warning', badge: 'bg-warning/10 text-warning'},
    error:   {bar: 'bg-error', badge: 'bg-error/10 text-error'},
}[healthSummary.severity] %}

{% set actionBtn = {
    success: 'btn-success',
    warning: 'btn-warning',
    error:   'btn-error',
    info:    'btn-primary',
}[nextAction.severity] ?? 'btn-primary' %}

<div class="rounded-2xl border border-base-200 bg-base-100 overflow-hidden shadow-sm mb-6">
    <div class="h-1 {{ tone.bar }}"></div>

    <div class="p-5">
        <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full flex items-center justify-center shrink-0 {{ tone.badge }}" aria-hidden="true">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    {% if healthSummary.severity == 'success' %}
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    {% else %}
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-2.5L13.73 4a2 2 0 00-3.46 0L3.34 16.5c-.77.83.19 2.5 1.73 2.5z"/>
                    {% endif %}
                </svg>
            </span>
            <h2 class="text-base font-semibold text-base-content flex-1 min-w-0">{{ healthSummary.headline }}</h2>
        </div>

        {% if healthSummary.domainsTotalCount > 0 %}
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-3 text-xs text-base-content/60">
                {% if healthSummary.domainsHealthyCount > 0 %}
                    <a href="{{ path('dashboard_domains', { status: 'healthy' }) }}" class="inline-flex items-center gap-1 hover:underline">
                        <span class="w-2 h-2 rounded-full bg-success" aria-hidden="true"></span>
                        {{ healthSummary.domainsHealthyCount }} healthy
                    </a>
                {% endif %}
                {% for item in attentionSummary.items %}
                    <a href="{{ path(item.route, item.routeParams) }}" class="hover:underline {{ item.colorClass }}">{{ item.label }}</a>
                {% endfor %}
            </div>
        {% endif %}

        <div class="mt-4 pt-4 border-t border-base-200">
            <div class="text-xs font-semibold uppercase tracking-wider text-base-content/50 mb-1">Next step</div>
            <h3 class="text-lg font-semibold text-base-content mb-1">{{ nextAction.title }}</h3>
            <p class="text-sm text-base-content/70 mb-3 max-w-2xl">{{ nextAction.description }}</p>

            {% if nextAction.ctaRoute == 'dashboard_domain_reverify' %}
                {# dashboard_domain_reverify is POST-only, so rendering this CTA
                   as a plain <a href> walks the user into a 405. It is the same
                   throttled action as every other re-check control, so it goes
                   through the shared component. #}
                <twig:RecheckDnsButton
                    :domainId="nextAction.ctaRouteParams.id"
                    label="{{ nextAction.ctaLabel }}"
                    buttonClass="btn-sm {{ actionBtn }}" />
            {% else %}
                <a href="{{ path(nextAction.ctaRoute, nextAction.ctaRouteParams) }}" class="btn btn-sm {{ actionBtn }}">
                    {{ nextAction.ctaLabel }}
                </a>
            {% endif %}

            {% if nextAction.secondaryCtaRoute is not null %}
                <div class="mt-3 flex items-center gap-3 text-sm">
                    <a href="{{ path(nextAction.secondaryCtaRoute) }}" class="link link-hover text-base-content/70">
                        {{ nextAction.secondaryCtaLabel }}
                    </a>
                    {# Dismiss only fires for the generic DNS-first nudge — scenario-(c)
                       ConnectExternalMailbox is driven by the live DMARC record and would
                       re-emit on every render regardless of the dismissal flag. #}
                    {% if nextAction.actionKey.value in ['publish_rua_record', 'connect_mailbox'] %}
                        <form method="post" action="{{ path('dashboard_ingestion_recommendation_dismiss') }}" class="inline">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('ingestion_recommendation_dismiss') }}">
                            <button type="submit" class="link link-hover text-base-content/50 text-xs">Dismiss</button>
                        </form>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
