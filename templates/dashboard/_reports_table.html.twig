{% import 'components/_severity_glyph.html.twig' as severity %}
<turbo-frame id="reports-table">
    <div class="card bg-base-100 border border-base-200 shadow-sm">
        <div class="card-body p-4">
            <div class="overflow-x-auto">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            {# 32px-wide leading severity glyph (TASK-069). sr-only
                               header so the column is screen-reader-labelled but
                               visually anonymous — the glyph is the cue, the
                               Pass Rate column on the right is the precise label. #}
                            <th class="w-8"><span class="sr-only">Health</span></th>
                            <th>Domain</th>
                            <th>Reporter</th>
                            <th>Date Range</th>
                            <th class="text-right">Records</th>
                            <th class="text-right">Pass Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        {# Row navigation: ONE real, visible anchor on the domain cell plus the
                           generic `row-link` Stimulus controller for whole-row click convenience.
                           The previous stretched-link overlay (`absolute inset-0 z-10` inside a
                           `<tr class="relative">`) is deliberately gone: CSS 2.1 §9.3.1 leaves the
                           effect of position:relative on a table-row UNDEFINED and daisyUI's
                           `.table` is itself position:relative, so in browsers that ignore it every
                           row's overlay sized itself to the whole table, they stacked, and the last
                           row in DOM order swallowed every click — making every row open the oldest
                           report. See assets/controllers/row_link_controller.js for the contract.
                           data-turbo-frame="_top" is required because this table lives in
                           <turbo-frame id="reports-table"> — without it the report-detail page
                           would be swapped into this frame instead of loading as a full page.
                           Leading severity glyph + `border-l-{tone}` per TASK-069: a single failing
                           report jumps off the page instead of forcing the user to read every number. #}
                        {% for report in reports %}
                            {% set reportTone = severity.pass_rate_tone(report.passRate)|trim %}
                            <tr class="hover:bg-base-200/50 cursor-pointer border-l-4 border-l-{{ severity.pass_rate_row_tone(report.passRate)|trim }}"
                                {{ stimulus_controller('row-link') }}
                                data-action="click->row-link#navigate">
                                <td class="w-8">
                                    {{ severity.glyph(reportTone, 'sm') }}
                                </td>
                                <td class="font-medium">
                                    <a href="{{ path('dashboard_report_detail', { id: report.reportId }) }}"
                                       class="link link-hover"
                                       data-row-link-target="link"
                                       data-turbo-frame="_top"
                                       aria-label="View report from {{ report.reporterOrg }} for {{ report.domainName }}">{{ report.domainName }}</a>
                                </td>
                                <td>{{ report.reporterOrg }}</td>
                                <td>{{ report.dateRangeBegin|date('M j') }} — {{ report.dateRangeEnd|date('M j, Y') }}</td>
                                <td class="text-right">{{ report.recordCount }}</td>
                                {# A report with no records observed no mail, so it has no pass
                                   rate — the shared macros print "—" for that and tint it the
                                   muted no-data colour, instead of the red 0.0% a bare
                                   number_format would produce from a null. #}
                                <td class="text-right">
                                    <span class="{{ severity.pass_rate_class(report.passRate)|trim }}">
                                        {{ severity.pass_rate_value(report.passRate) }}
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Pagination #}
            <div class="flex items-center justify-between mt-4">
                <div class="text-xs text-base-content/50">
                    Page {{ currentPage }}
                </div>
                <div class="join">
                    {% if currentPage > 1 %}
                        <a href="{{ path('dashboard_reports', filterParams|merge({ page: currentPage - 1 })) }}"
                           class="join-item btn btn-sm"
                           data-turbo-frame="reports-table">Previous</a>
                    {% endif %}
                    {% if hasNextPage %}
                        <a href="{{ path('dashboard_reports', filterParams|merge({ page: currentPage + 1 })) }}"
                           class="join-item btn btn-sm"
                           data-turbo-frame="reports-table">Next</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</turbo-frame>
