{% extends 'dashboard/layout.html.twig' %}

{% block page_title %}Blacklist Status — {{ domain.domainName }}{% endblock %}
{% block breadcrumbs %}
    <li><a href="{{ path('dashboard_domains') }}">Domains</a></li>
    <li><a href="{{ path('dashboard_domain_detail', { id: domain.domainId }) }}">{{ domain.domainName }}</a></li>
    <li>Blacklist Status</li>
{% endblock %}

{% block page_heading %}
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold">Blacklist Status</h1>
            <p class="text-sm text-base-content/60 mt-1">IP blacklist monitoring for {{ domain.domainName }}</p>
        </div>
    </div>
{% endblock %}

{% block content %}
    <twig:DomainWorkspaceTabs :domain="domain" active="blacklist" :tabCounts="tabCounts" />

    {% if statusResults is empty %}
        <div class="card bg-base-100 shadow">
            <div class="card-body text-center py-12">
                {# The old copy promised "Checks will run automatically for known
                   sender IPs." Nothing dispatches CheckBlacklist today — there is
                   no scheduled blacklist job — so that was a commitment the
                   product does not keep. Say what is actually true. #}
                <p class="text-base-content/60">No blacklist results for this domain yet.</p>
                <p class="text-sm text-base-content/50 mt-2">
                    Automatic blacklist monitoring is not switched on yet, so treat an empty list as
                    &ldquo;not checked&rdquo; rather than &ldquo;not listed&rdquo;. You can check any IP
                    right now with the <a href="{{ path('tools_blacklist_checker') }}" class="link">blacklist checker</a>.
                </p>
            </div>
        </div>
    {% else %}
        <div class="space-y-4">
            {% for result in statusResults %}
                <div class="card bg-base-100 shadow">
                    <div class="card-body">
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center gap-3">
                                <span class="font-mono font-medium">{{ result.ipAddress }}</span>
                                {# "Clean" is a claim, and we can only make it about lists that
                                   actually answered. When none did, say so instead. #}
                                {% if result.isListed %}
                                    <span class="badge badge-error">Listed on {{ result.listedCount() }} blacklist(s)</span>
                                {% elseif result.isInconclusive() %}
                                    <span class="badge badge-ghost">Couldn&rsquo;t be checked</span>
                                {% else %}
                                    <span class="badge badge-success">Clean on {{ result.answeredCount() }} of {{ result.totalChecked() }}</span>
                                {% endif %}
                            </div>
                            <span class="text-sm text-base-content/60">Checked: {{ result.checkedAt|date('M j, Y H:i') }}</span>
                        </div>

                        {% if result.unavailableCount() > 0 %}
                            <p class="text-sm text-base-content/60 mb-3">
                                {{ result.unavailableCount() }} blocklist(s) didn&rsquo;t answer our query — that&rsquo;s a gap in our
                                coverage, not a finding against this IP.
                            </p>
                        {% endif %}

                        <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                            {% for listing in result.listings %}
                                {% set isListed = listing.status.value == 'listed' %}
                                {% set isUnavailable = listing.status.value == 'check_failed' %}
                                <div class="flex items-center gap-2 px-3 py-2 rounded {{ isListed ? 'bg-error/10' : (isUnavailable ? 'bg-base-200' : 'bg-success/10') }}"
                                     {% if listing.reason %}title="{{ listing.reason }}"{% endif %}>
                                    {% if isListed %}
                                        <svg class="w-4 h-4 text-error shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                    {% elseif isUnavailable %}
                                        <svg class="w-4 h-4 text-base-content/40 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    {% else %}
                                        <svg class="w-4 h-4 text-success shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                    {% endif %}
                                    <span class="text-sm truncate {{ isUnavailable ? 'text-base-content/50' : '' }}">{{ listing.dnsbl }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
