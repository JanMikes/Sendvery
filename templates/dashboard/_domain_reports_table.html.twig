<turbo-frame id="domain-reports-table">
    <div class="card bg-base-100 border border-base-200 shadow-sm">
        <div class="card-body p-4">
            <div class="overflow-x-auto">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Reporter</th>
                            <th>Date Range</th>
                            <th class="text-right">Records</th>
                            <th class="text-right">Pass Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        {# Row navigation: real anchor on the reporter cell + the generic `row-link`
                           Stimulus controller. Never reinstate an `absolute inset-0` overlay inside
                           a `<tr class="relative">` — positioning a table-row is undefined in CSS,
                           which made every row of this table open the same report. Contract lives in
                           assets/controllers/row_link_controller.js. #}
                        {% for report in reports %}
                            <tr class="hover:bg-base-200/50 cursor-pointer"
                                {{ stimulus_controller('row-link') }}
                                data-action="click->row-link#navigate">
                                <td class="font-medium">
                                    <a href="{{ path('dashboard_report_detail', { id: report.reportId }) }}"
                                       class="link link-hover"
                                       data-row-link-target="link"
                                       data-turbo-frame="_top"
                                       aria-label="View report from {{ report.reporterOrg }} covering {{ report.dateRangeBegin|date('M j') }} to {{ report.dateRangeEnd|date('M j, Y') }}">{{ report.reporterOrg }}</a>
                                </td>
                                <td>{{ report.dateRangeBegin|date('M j') }} — {{ report.dateRangeEnd|date('M j, Y') }}</td>
                                <td class="text-right">{{ report.recordCount }}</td>
                                <td class="text-right">
                                    <span class="{{ report.passRate >= 90 ? 'text-success' : (report.passRate >= 70 ? 'text-warning' : 'text-error') }}">
                                        {{ report.passRate|number_format(1) }}%
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Pagination #}
            <div class="flex items-center justify-between mt-4">
                <div class="text-xs text-base-content/50">
                    Page {{ currentPage }}
                </div>
                <div class="join">
                    {% if currentPage > 1 %}
                        <a href="{{ path('dashboard_domain_reports', filterParams|merge({ id: domainId, page: currentPage - 1 })) }}"
                           class="join-item btn btn-sm"
                           data-turbo-frame="domain-reports-table">Previous</a>
                    {% endif %}
                    {% if hasNextPage %}
                        <a href="{{ path('dashboard_domain_reports', filterParams|merge({ id: domainId, page: currentPage + 1 })) }}"
                           class="join-item btn btn-sm"
                           data-turbo-frame="domain-reports-table">Next</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</turbo-frame>
