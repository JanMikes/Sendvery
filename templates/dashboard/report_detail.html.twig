{% extends 'dashboard/layout.html.twig' %}

{% block page_title %}Report {{ report.externalReportId }}{% endblock %}
{% block breadcrumbs %}
    <li><a href="{{ path('dashboard_reports') }}">Reports</a></li>
    <li>{{ report.externalReportId|length > 30 ? report.externalReportId[:30] ~ '...' : report.externalReportId }}</li>
{% endblock %}

{% block page_heading %}
    {# Report header #}
    <div class="mb-6">
        <h1 class="text-2xl font-bold">Report from {{ report.reporterOrg }}</h1>
        <p class="text-sm text-base-content/50 mt-1">
            {{ report.dateRangeBegin|date('M j, Y') }} — {{ report.dateRangeEnd|date('M j, Y') }}
            <span class="mx-2">|</span>
            External ID: <span class="font-mono text-xs">{{ report.externalReportId }}</span>
        </p>
    </div>
{% endblock %}

{% block content %}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
        {# Report metadata #}
        <div class="card bg-base-100 border border-base-200 shadow-sm lg:col-span-2">
            <div class="card-body p-4">
                <h3 class="text-sm font-semibold mb-3">Report Details</h3>
                <div class="grid grid-cols-2 gap-3 text-sm">
                    <div>
                        <span class="text-base-content/50">Reporter</span>
                        <p class="font-medium">{{ report.reporterOrg }}</p>
                    </div>
                    <div>
                        <span class="text-base-content/50">Reporter Email</span>
                        <p class="font-medium">{{ report.reporterEmail }}</p>
                    </div>
                    <div>
                        <span class="text-base-content/50">Policy Domain</span>
                        <p class="font-medium">{{ report.policyDomain }}</p>
                    </div>
                    <div>
                        <span class="text-base-content/50">Processed</span>
                        <p class="font-medium">{{ report.processedAt|date('M j, Y H:i') }}</p>
                    </div>
                </div>

                <div class="divider my-3"></div>

                <h3 class="text-sm font-semibold mb-3">Published Policy</h3>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-sm">
                    <div>
                        <span class="text-base-content/50">Policy (p)</span>
                        <p><twig:StatusBadge status="{{ report.policyP }}" label="p={{ report.policyP }}" /></p>
                    </div>
                    {% if report.policySp %}
                        <div>
                            <span class="text-base-content/50">Subdomain (sp)</span>
                            <p><twig:StatusBadge status="{{ report.policySp }}" label="sp={{ report.policySp }}" /></p>
                        </div>
                    {% endif %}
                    <div>
                        <span class="text-base-content/50">DKIM Alignment</span>
                        <p class="font-medium">{{ report.policyAdkim == 'r' ? 'Relaxed' : 'Strict' }}</p>
                    </div>
                    <div>
                        <span class="text-base-content/50">SPF Alignment</span>
                        <p class="font-medium">{{ report.policyAspf == 'r' ? 'Relaxed' : 'Strict' }}</p>
                    </div>
                    <div>
                        <span class="text-base-content/50">Percentage</span>
                        <p class="font-medium">{{ report.policyPct }}%</p>
                    </div>
                </div>
            </div>
        </div>

        {# Pass/fail donut #}
        <div class="card bg-base-100 border border-base-200 shadow-sm">
            <div class="card-body p-4">
                <h3 class="text-sm font-semibold mb-2">Authentication Summary</h3>
                <div class="text-center mb-2">
                    <span class="text-3xl font-bold">{{ totalMessages }}</span>
                    <span class="text-sm text-base-content/50 block">total messages</span>
                </div>
                <div {{ stimulus_controller('chart', { config: donutConfig }) }} style="min-height: 200px"></div>
                {# Where this total and the per-message rows below could look like they
                   disagree: both use the reporter's <policy_evaluated> DKIM/SPF results,
                   which already have DMARC alignment applied — that is also what the Pass
                   Rate column on the reports list counts, so the numbers match. The rows
                   below add the raw identifiers behind those results, and an aggregate
                   report names only one DKIM signature even when a message carried
                   several, so an identifier can look unaligned on a passing message. #}
                <p class="text-xs text-base-content/50 mt-2">
                    Counted from the reporter's evaluated DKIM and SPF results, which already include DMARC alignment — the same rule behind the Pass Rate column on the reports list. The breakdown below adds the identifiers behind each result.
                </p>
            </div>
        </div>
    </div>

    {# Plain-language failure explanation. Deliberately NOT gated behind `aiEnabled`:
       knowing why your mail failed DMARC is not a paid feature, and this is the part
       users came to the page for. #}
    {% set failingRecords = report.records|filter(record => not alignment[record.recordId].dmarcPass) %}
    <div class="card bg-base-100 border border-base-200 shadow-sm mb-6">
        <div class="card-body p-4">
            {% if report.records is empty %}
                {# Reporters do send reports with no rows at all. Saying "nothing
                   failed" there would claim a clean bill of health we never got. #}
                <h2 class="text-lg font-semibold">This report contains no message data</h2>
                <p class="text-sm text-base-content/60">
                    {{ report.reporterOrg }} sent a report for {{ report.policyDomain }} without any message rows, so there is nothing to pass or fail here.
                </p>
            {% elseif failingRecords is empty %}
                <h2 class="text-lg font-semibold">Nothing failed DMARC in this report</h2>
                <p class="text-sm text-base-content/60">
                    Every message {{ report.reporterOrg }} saw for {{ report.policyDomain }} authenticated and aligned with the From domain.
                </p>
            {% else %}
                <h2 class="text-lg font-semibold">What failed, and what it means</h2>
                <p class="text-sm text-base-content/60">
                    {{ failMessages }} of {{ totalMessages }} messages failed DMARC. A message passes only when DKIM or SPF
                    <em>authenticates</em> and its domain <em>aligns</em> with the From address — so each source below says which of the two broke, and why.
                </p>

                <div class="space-y-3 mt-3">
                    {% for record in failingRecords|slice(0, 10) %}
                        {% set verdict = alignment[record.recordId] %}
                        <div class="border-l-4 border-l-error bg-base-200/40 rounded-box p-3">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="badge badge-sm badge-{{ verdict.tone }}">{{ verdict.headline }}</span>
                                <span class="font-mono text-sm">{{ record.sourceIp }}</span>
                                {% if record.resolvedHostname ?? record.resolvedOrg %}
                                    <span class="text-sm text-base-content/60">{{ record.resolvedHostname ?? record.resolvedOrg }}</span>
                                {% endif %}
                                {# What the address IS, next to the verdict on what its mail
                                   DID. A gateway breaking SPF is forwarding working exactly
                                   as designed; without this the same red badge reads as an
                                   attack. "Unrecognised" is left off — it would sit on nearly
                                   every row and say nothing. #}
                                {% if record.senderRole is not null and record.senderRole.value != 'unknown' %}
                                    <span class="badge badge-sm badge-ghost" data-testid="record-sender-role">{{ record.senderRole.label }}</span>
                                {% endif %}
                                <span class="text-sm text-base-content/60">{{ record.count }} msg</span>
                                <span class="badge badge-sm badge-{{ verdict.dkim.badgeTone }}">DKIM {{ verdict.dkim.label }}</span>
                                <span class="badge badge-sm badge-{{ verdict.spf.badgeTone }}">SPF {{ verdict.spf.label }}</span>
                                <twig:StatusBadge status="{{ record.disposition }}" />
                            </div>

                            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 text-xs mt-3">
                                <div>
                                    <span class="text-base-content/50 block">From domain (header_from)</span>
                                    <span class="font-mono">{{ record.headerFrom }}</span>
                                </div>
                                <div>
                                    <span class="text-base-content/50 block">DKIM signing domain (d=)</span>
                                    <span class="font-mono">{{ record.dkimDomain ?? 'not signed' }}</span>
                                </div>
                                <div>
                                    <span class="text-base-content/50 block">DKIM selector (s=)</span>
                                    <span class="font-mono">{{ record.dkimSelector ?? '—' }}</span>
                                </div>
                                <div>
                                    <span class="text-base-content/50 block">SPF envelope domain</span>
                                    <span class="font-mono">{{ record.spfDomain ?? 'not reported' }}</span>
                                </div>
                            </div>

                            <ul class="list-disc list-inside text-sm space-y-1 mt-3">
                                {% for sentence in verdict.explanations %}
                                    <li>{{ sentence }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endfor %}
                </div>

                {% if failingRecords|length > 10 %}
                    <p class="text-xs text-base-content/50 mt-3">
                        Showing the 10 largest failing sources of {{ failingRecords|length }}. The rest are in the raw records table below.
                    </p>
                {% endif %}
            {% endif %}
        </div>
    </div>

    {% if aiEnabled %}
        <turbo-frame id="report-explanation">
            <div class="card bg-base-100 border border-base-200 shadow-sm mb-6">
                <div class="card-body p-4">
                    <h3 class="text-sm font-semibold mb-2">AI explanation</h3>
                    {% if cachedExplanation is not null %}
                        <div class="text-sm whitespace-pre-line">{{ cachedExplanation }}</div>
                    {% elseif routineExplanation is not null %}
                        <div class="text-sm whitespace-pre-line">{{ routineExplanation }}</div>
                    {% elseif showExplainButton %}
                        <p class="text-sm text-base-content/60 mb-3">Get a plain-language explanation of this report.</p>
                        <form method="post" action="{{ path('dashboard_report_explain', { id: report.reportId }) }}" data-turbo-frame="report-explanation">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('explain_report') }}">
                            <button type="submit" class="btn btn-primary btn-sm">Explain this report</button>
                            <span class="text-xs text-base-content/50 ml-2">{{ aiRemaining }} of {{ aiLimit }} left this month</span>
                        </form>
                    {% endif %}
                </div>
            </div>
        </turbo-frame>
    {% endif %}

    {# By sender grouped view #}
    <div class="mb-6">
        <h2 class="text-lg font-semibold mb-3">By sender</h2>
        <div class="space-y-2">
            {% for group in senderGroups %}
                {% set groupRecords = report.records|filter(record => record.sourceIp in group.sourceIps) %}
                {% set groupFailing = groupRecords|filter(record => not alignment[record.recordId].dmarcPass) %}
                {# Senders with a DMARC failure start expanded — a failing source the user
                   has to go hunting for behind a closed disclosure is a failing source the
                   user never fixes. #}
                <details class="group"{{ groupFailing is not empty ? ' open' : '' }}>
                    <summary class="card bg-base-100 border border-base-200 shadow-sm cursor-pointer list-none">
                        <div class="card-body p-3 flex flex-row flex-wrap items-center gap-3">
                            <span class="font-medium truncate max-w-[18rem]" title="{{ group.displayLabel }}">
                                {{ group.displayLabel|length > 50 ? group.displayLabel[:50] ~ '…' : group.displayLabel }}
                            </span>
                            {% if group.senderRole is not null and group.senderRole.value != 'unknown' %}
                                <span class="badge badge-sm badge-ghost" data-testid="sender-group-role">{{ group.senderRole.label }}</span>
                            {% endif %}
                            <span class="text-sm text-base-content/60">{{ group.totalMessages }} msg</span>
                            <span class="badge badge-sm badge-ghost">DKIM {{ group.dkimPassRate|number_format(0) }}%</span>
                            <span class="badge badge-sm badge-ghost">SPF {{ group.spfPassRate|number_format(0) }}%</span>
                            {% if group.dispositionNone > 0 %}
                                <span class="badge badge-sm badge-info">{{ group.dispositionNone }} none</span>
                            {% endif %}
                            {% if group.dispositionQuarantine > 0 %}
                                <span class="badge badge-sm badge-warning">{{ group.dispositionQuarantine }} quarantine</span>
                            {% endif %}
                            {% if group.dispositionReject > 0 %}
                                <span class="badge badge-sm badge-error">{{ group.dispositionReject }} reject</span>
                            {% endif %}
                            {% if group.reviewState is not null %}
                                <twig:SenderStatusBadge :state="group.reviewState" />
                            {% endif %}
                        </div>
                    </summary>
                    <div class="overflow-x-auto mt-1 ml-2 border-l-2 border-base-300 pl-3">
                        <table class="table table-xs">
                            <thead>
                                <tr>
                                    <th>Source IP</th>
                                    <th>Hostname</th>
                                    <th class="text-right">Count</th>
                                    <th>Disposition</th>
                                    <th>DMARC</th>
                                    <th>DKIM</th>
                                    <th>SPF</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for record in groupRecords %}
                                    {% set verdict = alignment[record.recordId] %}
                                    <tr>
                                        <td class="font-mono text-xs">{{ record.sourceIp }}</td>
                                        <td class="text-xs">{{ record.resolvedHostname ?? record.resolvedOrg ?? '—' }}</td>
                                        <td class="text-right font-medium">{{ record.count }}</td>
                                        <td><twig:StatusBadge status="{{ record.disposition }}" /></td>
                                        <td><span class="badge badge-sm badge-{{ verdict.tone }}">{{ verdict.dmarcPass ? 'pass' : 'fail' }}</span></td>
                                        <td>
                                            <twig:StatusBadge status="{{ record.dkimResult }}" />
                                            <span class="block text-xs text-base-content/60">
                                                {{ record.dkimDomain ? 'd=' ~ record.dkimDomain : 'no signature' }}{{ record.dkimSelector ? ' s=' ~ record.dkimSelector }} · {{ verdict.dkim.label }}
                                            </span>
                                        </td>
                                        <td>
                                            <twig:StatusBadge status="{{ record.spfResult }}" />
                                            <span class="block text-xs text-base-content/60">
                                                {{ record.spfDomain ?? 'not reported' }} · {{ verdict.spf.label }}
                                            </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </details>
            {% else %}
                <p class="text-sm text-base-content/50">No records in this report.</p>
            {% endfor %}
        </div>
    </div>

    {# Records table #}
    <details>
        <summary class="cursor-pointer mb-3">
            <span class="text-sm font-semibold">Show raw records ({{ report.records|length }})</span>
        </summary>
        <div class="card bg-base-100 border border-base-200 shadow-sm">
            <div class="card-body p-4">
                <h3 class="text-sm font-semibold mb-3">Records ({{ report.records|length }})</h3>

                <div class="overflow-x-auto">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Source IP</th>
                                <th>Hostname</th>
                                <th class="text-right">Count</th>
                                <th>Disposition</th>
                                <th>DMARC</th>
                                <th>DKIM</th>
                                <th>SPF</th>
                                <th>Header From</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for record in report.records %}
                                {% set verdict = alignment[record.recordId] %}
                                <tr>
                                    <td class="font-mono text-xs">{{ record.sourceIp }}</td>
                                    <td class="text-xs">{{ record.resolvedHostname ?? record.resolvedOrg ?? '—' }}</td>
                                    <td class="text-right font-medium">{{ record.count }}</td>
                                    <td><twig:StatusBadge status="{{ record.disposition }}" /></td>
                                    <td><span class="badge badge-sm badge-{{ verdict.tone }}">{{ verdict.dmarcPass ? 'pass' : 'fail' }}</span></td>
                                    <td>
                                        <twig:StatusBadge status="{{ record.dkimResult }}" />
                                        <span class="block text-xs text-base-content/60">
                                            {{ record.dkimDomain ? 'd=' ~ record.dkimDomain : 'no signature' }}{{ record.dkimSelector ? ' s=' ~ record.dkimSelector }} · {{ verdict.dkim.label }}
                                        </span>
                                    </td>
                                    <td>
                                        <twig:StatusBadge status="{{ record.spfResult }}" />
                                        <span class="block text-xs text-base-content/60">
                                            {{ record.spfDomain ?? 'not reported' }} · {{ verdict.spf.label }}
                                        </span>
                                    </td>
                                    <td class="text-xs">{{ record.headerFrom }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </details>
{% endblock %}
