{% extends 'dashboard/layout.html.twig' %}

{% block page_title %}Health — {{ domain.domainName }}{% endblock %}
{% block breadcrumbs %}
    <li><a href="{{ path('dashboard_domains') }}">Domains</a></li>
    <li><a href="{{ path('dashboard_domain_detail', { id: domain.domainId }) }}">{{ domain.domainName }}</a></li>
    <li>Health</li>
{% endblock %}

{% block page_heading %}
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold">Domain Health</h1>
            <p class="text-sm text-base-content/60 mt-1">Health score and trend for {{ domain.domainName }}</p>
        </div>
        <div class="flex items-center gap-2">
            {# Someone who has just published a record lands here to find out
               whether it took. Waiting for the 03:00 cron is not an answer, so
               the re-check is the page's primary action and sits in the header
               row where the other page-level actions already live. #}
            <twig:RecheckDnsButton :domainId="domain.domainId" label="Re-check DNS" buttonClass="btn-sm btn-primary" />
            <a href="{{ path('dashboard_export_domain_pdf', { id: domain.domainId }) }}" class="btn btn-ghost btn-sm">
                Export PDF
            </a>
            {% if latest and latest.shareHash %}
                <a href="{{ path('public_domain_health', { hash: latest.shareHash }) }}" target="_blank" class="btn btn-ghost btn-sm">
                    Share
                </a>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block content %}
    <twig:DomainRecheckNotice />

    <twig:DomainWorkspaceTabs :domain="domain" active="dns" :tabCounts="tabCounts" />

    {# AI guidance narrates the fix in plain language; the exact records to
       publish come from PHP in the cards below (never from the model). #}
    {% if aiRemediation is not null %}
        <div class="card bg-base-100 border border-base-200 shadow-sm mb-6">
            <div class="card-body p-4">
                <h3 class="text-sm font-semibold mb-2">AI guidance</h3>
                <p class="text-sm leading-relaxed whitespace-pre-line">{{ aiRemediation.instructionsMarkdown }}</p>
                <p class="text-xs text-base-content/50 mt-3">Generated by Claude · use the exact records below to apply the fix.</p>
            </div>
        </div>
    {% endif %}

    {# The canonical per-domain DNS setup surface, in full mode: every tier
       expanded, both report-delivery paths offered. The domain detail page
       renders the same component compactly and links here — there is no second
       presentation of these facts any more. #}
    <twig:GuidedDnsSetup
        :setup="guidedDnsSetup"
        :domainId="domain.domainId"
        :domainName="domain.domainName"
        mode="full" />

    {% if latest %}
        {# Current score #}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
            <div id="health-score" class="card bg-base-100 shadow">
                <div class="card-body items-center text-center">
                    <div class="text-7xl font-bold {{ latest.gradeColor() }}">{{ latest.grade }}</div>
                    <div class="text-2xl font-semibold mt-2">{{ latest.score }}/100</div>
                    <p class="text-sm text-base-content/60 mt-1">Overall Health Score</p>
                </div>
            </div>

            <div class="col-span-2 card bg-base-100 shadow">
                <div class="card-body">
                    <h3 class="card-title text-lg mb-4">Category Scores</h3>
                    <div class="space-y-3">
                        {# Blacklist is deliberately NOT a scored category here — see
                           the public health page for the full reason: the stored
                           `blacklist_score` is a hardcoded 100, not a measurement,
                           so a green bar claimed a clean result nobody checked.
                           The row below links to the Blacklist tab and says so. #}
                        {% set categories = [
                            { name: 'SPF',       score: latest.spfScore,       id: 'health-spf' },
                            { name: 'DKIM',      score: latest.dkimScore,      id: 'health-dkim' },
                            { name: 'DMARC',     score: latest.dmarcScore,     id: 'health-dmarc' },
                            { name: 'MX',        score: latest.mxScore,        id: 'health-mx' },
                        ] %}
                        {% for cat in categories %}
                            <div id="{{ cat.id }}">
                                <div class="flex justify-between text-sm mb-1">
                                    <span>{{ cat.name }}</span>
                                    <span class="font-medium">{{ cat.score }}%</span>
                                </div>
                                <progress class="progress {{ cat.score >= 80 ? 'progress-success' : (cat.score >= 50 ? 'progress-warning' : 'progress-error') }} w-full" value="{{ cat.score }}" max="100"></progress>
                            </div>
                        {% endfor %}
                        <div id="health-blacklist" class="flex justify-between text-sm">
                            <a href="{{ path('dashboard_blacklist_status', {id: domain.domainId}) }}" class="link link-hover">Blacklist</a>
                            <span class="text-base-content/50">Not checked yet</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Trend chart #}
        {% if trendChartConfig %}
            <div id="health-trend" class="card bg-base-100 shadow mb-6">
                <div class="card-body">
                    <h3 class="card-title text-lg">Score Trend</h3>
                    <div {{ stimulus_controller('chart') }} {{ stimulus_target('chart', 'canvas') }} data-chart-config-value="{{ trendChartConfig|json_encode }}"></div>
                </div>
            </div>
        {% endif %}
    {% else %}
        <div class="card bg-base-100 shadow">
            <div class="card-body text-center py-12">
                <p class="text-base-content/60">No health score yet.</p>
                <p class="text-sm text-base-content/50 mt-2">A score is recorded every time we check your DNS — including the check that runs the moment you add a domain. The setup guide above is up to date either way.</p>
            </div>
        </div>
    {% endif %}
{% endblock %}
