<div class="card bg-base-100 border border-base-300 mt-6">
    <div class="card-body">
        <div class="flex items-center justify-between mb-4">
            <h3 class="card-title text-lg">
                Blacklist Results for <span class="font-mono text-primary">{{ domain }}</span>
                {% if result.ipAddress != domain %}
                    <span class="text-sm font-normal text-base-content/50">(resolved to {{ result.ipAddress }})</span>
                {% endif %}
            </h3>
            {# A blocklist that refused our query is neither a pass nor a fail.
               When none of them answered we have no verdict to badge at all. #}
            {% if result.isListed %}
                {% include 'tools/_results/_status_badge.html.twig' with {status: 'fail'} %}
            {% elseif result.isInconclusive %}
                {% include 'tools/_results/_status_badge.html.twig' with {status: 'unknown'} %}
            {% else %}
                {% include 'tools/_results/_status_badge.html.twig' with {status: 'pass'} %}
            {% endif %}
        </div>

        {% if result.unavailableCount > 0 %}
            <div class="alert alert-info mb-4">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>
                    {{ result.unavailableCount }} of {{ result.totalChecked }} blocklists did not answer our query, so
                    {% if result.isInconclusive %}
                        we can&rsquo;t tell you anything about this IP yet.
                    {% else %}
                        this result covers the {{ result.answeredCount }} that did.
                    {% endif %}
                    This is a limitation on our side, not a finding against the IP.
                </span>
            </div>
        {% endif %}

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
            <div class="stat bg-base-200 rounded-lg p-3">
                <div class="stat-title text-xs">Lists answered</div>
                <div class="stat-value text-lg">{{ result.answeredCount }}<span class="text-sm font-normal text-base-content/50">/{{ result.totalChecked }}</span></div>
            </div>
            <div class="stat bg-base-200 rounded-lg p-3">
                <div class="stat-title text-xs">Listings</div>
                <div class="stat-value text-lg {{ result.listedCount > 0 ? 'text-error' : (result.isInconclusive ? 'text-base-content/40' : 'text-success') }}">
                    {{ result.isInconclusive ? '—' : result.listedCount }}
                </div>
            </div>
        </div>

        <div class="space-y-2">
            {% for listing in result.listings %}
                {% set isListed = listing.status.value == 'listed' %}
                {% set isUnavailable = listing.status.value == 'check_failed' %}
                <div class="flex items-start justify-between gap-3 p-3 rounded-lg {{ isListed ? 'bg-error/5 border border-error/10' : (isUnavailable ? 'bg-base-200/30' : 'bg-base-200/50') }}">
                    <div class="min-w-0">
                        <code class="text-sm font-mono">{{ listing.dnsbl }}</code>
                        {% if listing.reason %}
                            <p class="text-xs text-base-content/60 mt-1 break-words">{{ listing.reason }}</p>
                        {% endif %}
                    </div>
                    {% if isListed %}
                        <span class="badge badge-error gap-1 shrink-0">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            Listed
                        </span>
                    {% elseif isUnavailable %}
                        <span class="badge badge-ghost gap-1 shrink-0">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Couldn&rsquo;t check
                        </span>
                    {% else %}
                        <span class="badge badge-success badge-outline gap-1 shrink-0">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            Clean
                        </span>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</div>
